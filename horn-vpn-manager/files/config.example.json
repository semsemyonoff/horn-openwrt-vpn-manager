{
  "singbox": {
    "log_level": "warn",
    "test_url": "https://www.gstatic.com/generate_204",
    "template": "",
    "connect_timeout": "3s"
  },
  "fetch": {
    "retries": 3,
    "timeout_seconds": 15,
    "parallelism": 2,
    "list_cache_ttl": "6h"
  },
  "routing": {
    "domains": {
      "url": "https://example.com/domains.lst"
    },
    "subnets": {
      "urls": [
        "https://example.com/subnets1.lst",
        "https://example.com/subnets2.lst"
      ],
      "manual_file": "/etc/horn-vpn-manager/lists/manual-ip.lst"
    }
  },
  "subscriptions": {
    "personal": {
      "name": "Personal VPS",
      "nodes": [
        "vless://11111111-2222-3333-4444-555555555555@203.0.113.10:443?type=tcp&security=reality&sni=example.com&fp=chrome&pbk=PUBLIC_KEY&sid=00112233#Personal"
      ],
      "default": true,
      "enabled": true,
      "fallback": {
        "subscriptions": ["provider"],
        "blacklist_timeout": "1m"
      }
    },
    "api": {
      "name": "Self-hosted hysteria2 (QUIC/UDP) — inline node, port optional and defaults to 443, auth is the whole userinfo",
      "nodes": [
        "hysteria2://AUTH_PASSWORD@203.0.113.20?sni=example.com&obfs=salamander&obfs-password=OBFS_PASSWORD#API+over+hysteria2"
      ],
      "route": {
        "domains": ["api.example.com"]
      }
    },
    "provider": {
      "name": "Provider",
      "url": "https://example.com/sub",
      "exclude": ["Russia", "traffic"],
      "interval": "5m",
      "tolerance": 300
    },
    "work": {
      "name": "Work",
      "url": "https://example.com/work",
      "route": {
        "domains": ["jira.example.com"],
        "domain_urls": [
          "https://example.com/work-domains.lst"
        ],
        "ip_cidrs": ["203.0.113.0/24"],
        "ip_urls": [
          "https://example.com/work-ips.lst"
        ]
      }
    }
  }
}
